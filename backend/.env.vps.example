# ============================================================
# Backend .env for VPS deployment — copy to backend/.env and fill in.
# These are the variables backend-server.js actually reads.
# Values marked (Railway) should be copied from your Railway Variables tab.
# ============================================================

# --- Core ---
PORT=5000
MONGODB_URI=            # (Railway) MongoDB Atlas connection string
JWT_SECRET=             # (Railway) keep the SAME value or all logins are invalidated
PORTAL_URL=https://portal.gnbmentor.com
CORS_ORIGIN=https://portal.gnbmentor.com
BRAND_NAME=

# --- Frontend build vars (were set on VERCEL; the VPS build reads them from here) ---
# Leave REACT_APP_API_URL blank — the app auto-uses https://portal.gnbmentor.com/api.
REACT_APP_GOOGLE_MAPS_API_KEY=       # (Vercel) Google Maps JS API key — maps won't load without it
REACT_APP_GOOGLE_SIGNIN_CLIENT_ID=   # (Vercel) usually the same as GOOGLE_OAUTH_CLIENT_ID below

# --- Google reseller: Pakistan account ---
GOOGLE_SERVICE_ACCOUNT_JSON=      # (Railway) the full JSON on one line
RESELLER_ADMIN_EMAIL=             # PK reseller super-admin email
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=        # update to https://<your-api-domain>/api/google/callback (match Google Cloud Console)
GOOGLE_SIGNIN_CLIENT_ID=
GOOGLE_ACCOUNT_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# --- Google reseller: USA account ---
GOOGLE_SERVICE_ACCOUNT_JSON_USA=  # (Railway) full JSON on one line
RESELLER_ADMIN_EMAIL_USA=
GOOGLE_OAUTH_CLIENT_ID_USA=
GOOGLE_OAUTH_CLIENT_SECRET_USA=
GOOGLE_OAUTH_REDIRECT_URI_USA=    # update to the new api domain too

# --- Stripe ---
STRIPE_SECRET_KEY=                # live secret key
STRIPE_SECRET_KEY_TEST=
STRIPE_WEBHOOK_SECRET=            # NEW signing secret after you point the webhook at the VPS URL

# --- Nicky (crypto) ---
NICKY_API_TOKEN=
NICKY_API_BASE=https://api-public.pay.nicky.me
NICKY_ASSET_ID=                   # required or Nicky checkout shows "Payment Order Not Found"

# --- Namecheap domains API ---
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=
NAMECHEAP_CLIENT_IP=              # MUST be this VPS's public IP, and whitelist it in Namecheap API settings
NAMECHEAP_SANDBOX=false
NAMECHEAP_MARKUP_PERCENT=

# --- Email (Gmail SMTP + optional Resend) ---
EMAIL_USER=
EMAIL_PASSWORD=                   # Gmail app password
EMAIL_FROM=
EMAIL_FROM_NAME=
EMAIL_FROM_ADDRESS=
RESEND_API_KEY=
ADMIN_EMAIL=
ADMIN_NOTIFY_EMAIL=

# --- DNA / SOAP domain provider (if used) ---
DNA_API_BASE=
DNA_API_KEY=
DNA_USERNAME=
DNA_PASSWORD=
DNA_RESELLER_ID=
DNA_SOAP_WSDL=
DNA_NS1=
DNA_NS2=
DNA_MARKUP_PERCENT=
